PORT=4000
# Local:
MONGODB_URI=mongodb://127.0.0.1:27017/arts_ai
# Atlas example (put real URI only in .env — never commit secrets):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/arts_ai?retryWrites=true&w=majority
JWT_SECRET=change_me_local_only
ML_INFERENCE_URL=http://127.0.0.1:8000
# Alias accepted by the API if ML_INFERENCE_URL is unset: ML_BASE_URL

# Recommendations: prerequisite_aware (default) | trained_ranker (opt-in only)
RECOMMENDATION_POLICY=prerequisite_aware

# --- Meeting provider (optional; URLs stay null until live smoke passes) ---
# Implemented adapter: http_webhook — POST {MEETING_API_BASE}/meetings
# Response must include joinUrl|meetingUrl|url and id|meetingId
MEETING_INTEGRATION=unconfigured
MEETING_PROVIDER=
MEETING_API_BASE=
MEETING_API_KEY=
MEETING_TIMEOUT_MS=15000
MEETING_TIMEZONE=Asia/Colombo
# Do NOT set MEETING_PROVIDER_TESTED=true without backend/api/reports/meeting_smoke_test.json

# --- Generative chat (optional; default remains extractive_template) ---
# none | openai_compatible | local_transformers
ARTS_AI_GENERATION_PROVIDER=none
ARTS_AI_GENERATION_MODEL=
# e.g. https://api.openai.com/v1 or a compatible base URL
ARTS_AI_GENERATION_API_BASE=
# Server-side only — never commit real keys
ARTS_AI_LLM_API_KEY=
ARTS_AI_GENERATION_API_KEY_ENV=ARTS_AI_LLM_API_KEY
ARTS_AI_GENERATION_TIMEOUT_S=45
# Local models: never download silently
ARTS_AI_ALLOW_MODEL_DOWNLOAD=false
ARTS_AI_MAX_LOCAL_MODEL_GB=2.0

NODE_ENV=development

# Test/demo fixtures (canonical isTestFixture items). Never enable in production.
# Client allowTestFixtures=true alone is ignored unless this is true AND NODE_ENV≠production.
# ARTS_AI_ALLOW_TEST_FIXTURES=true
