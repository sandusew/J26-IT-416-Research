# Optional ML-side generation settings (read by arts_ai.c4_chatbot.generation)
# Prefer configuring on the process that runs uvicorn.

ARTS_AI_GENERATION_PROVIDER=none
ARTS_AI_GENERATION_MODEL=
ARTS_AI_GENERATION_API_BASE=
ARTS_AI_LLM_API_KEY=
ARTS_AI_GENERATION_API_KEY_ENV=ARTS_AI_LLM_API_KEY
ARTS_AI_GENERATION_TIMEOUT_S=45
ARTS_AI_ALLOW_MODEL_DOWNLOAD=false
ARTS_AI_MAX_LOCAL_MODEL_GB=2.0

# Fixture chat corpus (default chat is domain). Must be set on the uvicorn process —
# Node/API ARTS_AI_ALLOW_TEST_FIXTURES does NOT automatically apply here.
# Never enable in production (NODE_ENV=production or ARTS_AI_ENV=production).
# ARTS_AI_ALLOW_TEST_FIXTURES=true
# NODE_ENV=development
